# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=swiftcpq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=swiftcpq

# ─── Application ──────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgres://swiftcpq:changeme@swiftcpq-postgres:5432/swiftcpq
CORS_ORIGIN=http://localhost:5173

# ─── Secrets ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-another-64-char-random-string
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret

# ─── Worker (optional) ───────────────────────────────────────
# WORKER_POLL_INTERVAL=5000
# WORKER_CLEANUP_INTERVAL=86400000

# ─── Microsoft Entra ID (optional — leave blank to disable) ──
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=
