NODE_ENV=development
DATABASE_URL=postgres://postgres:password@localhost:5432/swiftcpq_dev

# JWT secrets — change these to long random strings in production
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-2

# Allowed CORS origin for the frontend (dev default)
CORS_ORIGIN=http://localhost:5173

# Microsoft Entra ID (Azure AD) — leave blank to disable Entra login
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:5000/api/v1/auth/entra/callback
